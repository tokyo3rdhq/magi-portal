---
const features = [
  {
    key: 'performance',
    icon: 'speed',
  },
  {
    key: 'privacy',
    icon: 'lock',
  },
  {
    key: 'integration',
    icon: 'plug',
  },
  {
    key: 'scale',
    icon: 'scale',
  },
];
---

<section id="features" class="relative px-6 py-32 md:py-40 border-t border-line">
  <div class="mx-auto max-w-page">
    <div class="mx-auto max-w-wide text-center mb-24 md:mb-32">
      <p class="magi-eyebrow mb-5" data-i18n="features.eyebrow">Features</p>
      <h2
        class="magi-h2 text-4xl md:text-5xl lg:text-6xl text-balance"
        data-i18n="features.headline"
      >
        Engineered for production.
      </h2>
    </div>

    <div class="space-y-32 md:space-y-40">
      {features.map((feature, index) => (
        <div
          class:list={[
            'grid gap-10 md:gap-16 md:grid-cols-2 items-center',
            index % 2 === 1 && 'md:[&>*:first-child]:order-2',
          ]}
        >
          <!-- Copy side -->
          <div class="max-w-prose">
            <p
              class="magi-eyebrow mb-5"
              data-i18n={`features.items.${index}.eyebrow`}
            >
              {feature.key}
            </p>
            <h3
              class="magi-h3 text-3xl md:text-4xl lg:text-5xl mb-6 text-balance"
              data-i18n={`features.items.${index}.headline`}
            >
              Headline
            </h3>
            <p
              class="text-lg md:text-xl text-ink-secondary leading-relaxed text-balance"
              data-i18n={`features.items.${index}.body`}
            >
              Body
            </p>
          </div>

          <!-- Visual side — abstract accent block.
               bg-[...] now references --magi-accent (per spec §29: no duplicate values). -->
          <div class="aspect-[4/3] w-full rounded-2xl border border-line bg-bg-card overflow-hidden relative">
            <div
              class="absolute inset-0"
              style="background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--magi-accent) 12%, transparent) 0%, transparent 60%);"
            ></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-[120px] md:text-[160px] font-semibold tracking-tightest text-ink-primary/[0.04] select-none">
                {String(index + 1).padStart(2, '0')}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
