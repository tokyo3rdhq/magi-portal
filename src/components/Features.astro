---
const featureKeys = ['performance', 'privacy', 'integration', 'scalable', 'cost', 'global'];
---

<section id="features" class="py-24 px-6 bg-black/20">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-primary-400 font-medium mb-4 block" data-i18n="features.label">技术特点</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        <span data-i18n="features.title">为什么选择</span> <span class="text-primary-400" data-i18n="features.titleHighlight">我</span>
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto" data-i18n="features.description">
        专注于技术深度与用户体验，用心打磨每一个细节
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featureKeys.map((key, index) => (
        <div class="group p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-primary-500/30 transition-all duration-300">
          <div class="text-4xl mb-4">{['🚀', '🔒', '💡', '🔧', '💰', '🌐'][index]}</div>
          <h3 class="text-xl font-semibold mb-3 group-hover:text-primary-300 transition-colors" data-i18n={`features.items.${key}.title`}>
          </h3>
          <p class="text-slate-400 text-sm leading-relaxed" data-i18n={`features.items.${key}.description`}>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
