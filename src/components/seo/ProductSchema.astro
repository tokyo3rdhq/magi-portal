---
interface Props {
  name: string;
  description: string;
  url: string;
  price?: string;
}

const { name, description, url, price } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": name,
  "description": description,
  "url": url,
  ...(price && {
    "offers": {
      "@type": "Offer",
      "price": price,
      "priceCurrency": "USD"
    }
  })
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
