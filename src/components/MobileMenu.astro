---
/**
 * MobileMenu — accessible hamburger menu for responsive navigation.
 *
 * A mobile-only hamburger button toggles a full overlay that expands
 * from below the sticky header (top-11). The overlay sits at z-40 —
 * BELOW the header (z-50) — so the brand lockup, language switcher
 * and theme toggle stay visible and clickable while the menu is open.
 * Only the nav links live in the overlay; language/theme controls are
 * NOT duplicated here.
 *
 * A11y: aria-expanded + label swap on the trigger, dialog semantics,
 * Escape to close, body scroll lock while open.
 */
import { Menu } from 'lucide-static';

interface Props {
  items: Array<{ key: string; href: string }>;
}

const { items } = Astro.props;
---

<button
  id="mobile-menu-btn"
  type="button"
  class="md:hidden inline-flex h-9 w-9 items-center justify-center text-ink-secondary hover:text-ink-primary transition-colors"
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-label="Open navigation menu"
>
  <span class="mobile-menu-icon" set:html={Menu} />
</button>

<div
  id="mobile-menu"
  class="md:hidden fixed inset-0 top-11 z-40 hidden flex flex-col bg-overlay backdrop-blur-xl"
  role="dialog"
  aria-modal="true"
  aria-label="Main navigation"
>
  <nav class="flex-1 overflow-y-auto px-6 py-8">
    <ul class="space-y-1">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class="block rounded-lg px-3 py-3 text-base font-medium text-ink-primary hover:bg-white/5 hover:text-accent transition-colors"
            data-i18n={`nav.${item.key}`}
          >
            {item.key}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');

    /* The header has backdrop-blur, which makes it a containing block
       for fixed descendants. A fixed overlay inside the header would be
       sized to the 45px-tall header (top-11 + bottom-0 = ~1px strip:
       links render but the background covers nothing). Move the
       overlay to <body> so `position: fixed` resolves against the
       viewport. The overlay starts hidden, so no visual flash. */
    if (menu) document.body.appendChild(menu);

    if (btn && menu) {
      let previousScrollY = 0;

      const toggleMenu = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute(
          'aria-label',
          open ? 'Close navigation menu' : 'Open navigation menu'
        );
        if (open) {
          previousScrollY = window.scrollY;
          /* Lock scrolling on body only. Locking on documentElement
             breaks position:sticky for ancestor (head bar fix). */
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
          /* Restore scroll position in case an anchor left us positioned
             halfway down the document. */
          if (previousScrollY) window.scrollTo(0, previousScrollY);
        }
      };

      btn.addEventListener('click', () => {
        toggleMenu(menu.classList.contains('hidden'));
      });

      menu.querySelectorAll('a[href]').forEach((link) => {
        link.addEventListener('click', () => toggleMenu(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          toggleMenu(false);
        }
      });
    }
  </script>
  <style>
    /* Lucide ships 24x24 SVGs; the icon spans are 18x18 (smaller,
       navbar-sized). Scale the inline SVG to fill the box. */
    .mobile-menu-icon {
      display: inline-flex;
      height: 20px;
      width: 20px;
      line-height: 0;
    }
    .mobile-menu-icon :global(svg) {
      width: 100%;
      height: 100%;
    }
  </style>
