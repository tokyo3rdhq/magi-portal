---
---

<section class="relative min-h-screen flex items-center justify-center px-4 overflow-hidden">
  <!-- Scan line effect -->
  <div class="scan-line"></div>
  
  <!-- Main terminal container -->
  <div class="relative z-10 w-full max-w-5xl crt-overlay">
    <!-- Terminal header -->
    <div class="border border-[#00ff41]/30 bg-black/80 backdrop-blur-sm">
      <!-- Title bar -->
      <div class="flex items-center justify-between px-4 py-2 border-b border-[#00ff41]/30 bg-[#00ff41]/5">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#ff0055]"></span>
          <span class="w-3 h-3 rounded-full bg-[#ffaa00]"></span>
          <span class="w-3 h-3 rounded-full bg-[#00ff41]"></span>
        </div>
        <div class="terminal-dim text-xs">
          MAGI SYSTEM INTERFACE v3.14.159
        </div>
        <div class="terminal-dim text-xs">
          [NERV CENTRAL COMMAND]
        </div>
      </div>
      
      <!-- Terminal content -->
      <div class="p-6 md:p-10 font-mono text-sm md:text-base leading-relaxed">
        <!-- Boot sequence -->
        <div class="mb-6 space-y-1">
          <p class="terminal-dim">
            <span class="text-[#00ff41]/50">$</span> initializing MAGI neural network...
          </p>
          <p class="terminal-dim">
            <span class="text-[#00ff41]/50">$</span> loading three Magi subsystems...
          </p>
          <p class="terminal-text">
            <span class="text-[#00ffff]">[OK]</span> MELCHIOR kernel loaded
          </p>
          <p class="terminal-text">
            <span class="text-[#00ffff]">[OK]</span> BALTHASAR kernel loaded
          </p>
          <p class="terminal-text">
            <span class="text-[#00ffff]">[OK]</span> CASPAR kernel loaded
          </p>
          <p class="terminal-dim">
            <span class="text-[#00ff41]/50">$</span> establishing NERV HQ connection...
          </p>
        </div>
        
        <!-- Main message -->
        <div class="mb-8">
          <p class="terminal-dim mb-2">// SYSTEM STATUS</p>
          <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold mb-4 glitch">
            <span class="terminal-text">MAGI</span>
            <span class="text-[#ff00ff]">.</span>
            <span class="text-[#00ffff]">website</span>
          </h1>
          <div class="terminal-dim text-lg md:text-xl max-w-2xl">
            <p class="mb-2">
              > <span class="terminal-text">Personal AI Lab</span> // 
              <span class="text-[#ffaa00]">Independent Developer</span>
            </p>
            <p class="text-[#00ff41]/70">
              > Specialized in AI products and services, 
              building intelligent solutions at the edge.
            </p>
          </div>
        </div>
        
        <!-- System info -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 p-4 border border-[#00ff41]/20 bg-[#00ff41]/5">
          <div>
            <p class="terminal-dim text-xs mb-1">CORE_MODULES</p>
            <p class="terminal-text text-sm">API_GATEWAY</p>
            <p class="terminal-text text-sm">AI_CHAT</p>
            <p class="terminal-text text-sm">AGENT_SYSTEM</p>
          </div>
          <div>
            <p class="terminal-dim text-xs mb-1">NETWORK_STATUS</p>
            <p class="terminal-text text-sm pulse-glow inline-block px-2 py-0.5">ONLINE</p>
          </div>
          <div>
            <p class="terminal-dim text-xs mb-1">DEPLOY_PLATFORM</p>
            <p class="text-[#00ffff] text-sm">CLOUDFLARE_EDGE</p>
          </div>
        </div>
        
        <!-- Command prompt -->
        <div class="terminal-dim">
          <p class="mb-4">
            <span class="text-[#00ff41]/50">$</span> 
            <span class="terminal-text">available_commands:</span>
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#products" class="btn btn-terminal">
              <span class="mr-2">></span>
              <span data-i18n="hero.ctaProducts">VIEW_PRODUCTS</span>
            </a>
            <a href="#about" class="btn btn-highlight">
              <span class="mr-2">></span>
              <span data-i18n="hero.ctaContact">CONTACT_ME</span>
            </a>
          </div>
        </div>
        
        <!-- Blinking cursor -->
        <div class="mt-6 flex items-center">
          <span class="terminal-text text-2xl cursor-blink">▮</span>
          <span class="terminal-dim ml-2 text-sm">awaiting input...</span>
        </div>
      </div>
    </div>
    
    <!-- Decorative corner brackets -->
    <div class="absolute -top-1 -left-1 w-8 h-8 border-t-2 border-l-2 border-[#00ff41]"></div>
    <div class="absolute -top-1 -right-1 w-8 h-8 border-t-2 border-r-2 border-[#00ff41]"></div>
    <div class="absolute -bottom-1 -left-1 w-8 h-8 border-b-2 border-l-2 border-[#00ff41]"></div>
    <div class="absolute -bottom-1 -right-1 w-8 h-8 border-b-2 border-r-2 border-[#00ff41]"></div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 terminal-dim text-sm flex flex-col items-center gap-2">
    <span>SCROLL_DOWN</span>
    <span class="cursor-blink">▼</span>
  </div>
</section>
