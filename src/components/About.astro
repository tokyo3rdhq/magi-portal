---
const techStack = ['Astro', 'TypeScript', 'Cloudflare Workers', 'Tailwind CSS', 'Python', 'AI/ML'];
---

<section id="about" class="relative px-6 py-32 md:py-40 border-t border-line">
  <div class="mx-auto max-w-page">
    <div class="mx-auto max-w-wide text-center mb-20">
      <p class="eyebrow mb-5" data-i18n="about.eyebrow">About</p>
      <h2
        class="section-title text-4xl md:text-5xl lg:text-6xl text-balance whitespace-pre-line"
        data-i18n="about.headline"
      >
        Built by one.
Maintained with care.
      </h2>
    </div>

    <div class="grid gap-16 md:grid-cols-2 md:gap-24 max-w-page mx-auto">
      <!-- Story -->
      <div class="max-w-prose">
        <p
          class="text-lg md:text-xl text-ink-secondary leading-relaxed text-balance"
          data-i18n="about.body"
        >
          I am an independent developer focused on AI products and services.
        </p>

        <div class="mt-12 pt-8 border-t border-line">
          <p class="eyebrow mb-5" data-i18n="about.tech">Tech</p>
          <ul class="flex flex-wrap gap-2">
            {techStack.map((tech) => (
              <li class="rounded-full border border-line bg-bg-card px-3.5 py-1.5 text-xs text-ink-secondary">
                {tech}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Contact -->
      <div class="md:pl-8 md:border-l md:border-line">
        <p class="eyebrow mb-6" data-i18n="about.contact">Get in touch</p>
        <ul class="space-y-5">
          <li>
            <a
              href="mailto:hi@magi.website"
              class="group flex items-center justify-between rounded-xl border border-line bg-bg-card px-6 py-5 hover:border-line-strong hover:bg-white/[0.06] transition-all"
            >
              <div>
                <p class="text-xs text-ink-tertiary mb-1" data-i18n="about.emailLabel">Email</p>
                <p class="text-base text-ink-primary">hi@magi.website</p>
              </div>
              <span class="text-ink-tertiary group-hover:text-ink-primary transition-colors text-xl">›</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/tokyo3rdhq"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between rounded-xl border border-line bg-bg-card px-6 py-5 hover:border-line-strong hover:bg-white/[0.06] transition-all"
            >
              <div>
                <p class="text-xs text-ink-tertiary mb-1" data-i18n="about.githubLabel">GitHub</p>
                <p class="text-base text-ink-primary">github.com/tokyo3rdhq</p>
              </div>
              <span class="text-ink-tertiary group-hover:text-ink-primary transition-colors text-xl">›</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
