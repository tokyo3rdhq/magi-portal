---
const techStack = ['Astro', 'TypeScript', 'Cloudflare Workers', 'Tailwind CSS', 'Python', 'AI/ML'];
---

<section id="about" class="relative py-24 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Section header -->
    <div class="mb-12">
      <p class="terminal-dim text-sm mb-2">
        <span class="text-[#00ff41]/50">$</span> whoami
      </p>
      <h2 class="text-2xl md:text-4xl font-bold mb-4">
        <span class="terminal-dim">[</span>
        <span class="terminal-highlight" data-i18n="about.label">ABOUT_DEVELOPER</span>
        <span class="terminal-dim">]</span>
      </h2>
    </div>

    <!-- Content grid -->
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <!-- Avatar / MAGI visualization -->
      <div class="order-2 md:order-1">
        <div class="border border-[#00ff41]/30 bg-black/80 backdrop-blur-sm p-6">
          <!-- Terminal header -->
          <div class="flex items-center gap-2 mb-4 pb-4 border-b border-[#00ff41]/20">
            <span class="text-[#ff0055]">●</span>
            <span class="text-[#ffaa00]">●</span>
            <span class="text-[#00ff41]">●</span>
            <span class="terminal-dim text-xs ml-2" data-i18n="about.terminalTitle">MELCHIOR_VISUALIZATION.exe</span>
          </div>
          
          <!-- MAGI System visualization -->
          <div class="space-y-4">
            <!-- Main title -->
            <div class="text-center mb-6">
              <p class="terminal-dim text-xs" data-i18n="about.supercomputer">SUPERCOMPUTER SYSTEM</p>
              <h3 class="terminal-text text-2xl font-bold glitch">MAGI</h3>
              <p class="terminal-dim text-xs" data-i18n="about.namedAfter">// Named after the Three Wise Men</p>
            </div>
            
            <!-- Three Magi -->
            <div class="space-y-2 text-sm">
              <div class="flex items-center gap-2">
                <span class="text-[#ff00ff]">◆</span>
                <span class="terminal-text">MELCHIOR</span>
                <span class="terminal-dim" data-i18n="about.melchiorRole">- Logic Core</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#00ffff]">◆</span>
                <span class="terminal-text">BALTHASAR</span>
                <span class="terminal-dim" data-i18n="about.balthasarRole">- Judgment Core</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#ffaa00]">◆</span>
                <span class="terminal-text">CASPAR</span>
                <span class="terminal-dim" data-i18n="about.casparRole">- Wisdom Core</span>
              </div>
            </div>
            
            <!-- Status -->
            <div class="pt-4 border-t border-[#00ff41]/20">
              <p class="terminal-dim text-xs mb-2" data-i18n="about.systemStatus">SYSTEM_STATUS</p>
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#00ff41] pulse-glow"></span>
                <span class="terminal-text text-sm" data-i18n="about.operational">OPERATIONAL</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Text content -->
      <div class="order-1 md:order-2">
        <div class="space-y-4">
          <!-- Greeting -->
          <div class="terminal-dim">
            <p>
              <span class="text-[#00ff41]/50">></span> 
              <span data-i18n="about.paragraphs.0"></span>
            </p>
          </div>
          <div class="terminal-dim">
            <p>
              <span class="text-[#00ff41]/50">></span> 
              <span data-i18n="about.paragraphs.1"></span>
            </p>
          </div>
          <div class="terminal-dim">
            <p>
              <span class="text-[#00ff41]/50">></span> 
              <span data-i18n="about.paragraphs.2"></span>
            </p>
          </div>
        </div>

        <!-- Tech stack -->
        <div class="mt-8">
          <p class="terminal-dim text-sm mb-3">
            <span class="text-[#00ff41]/50">$</span> 
            <span class="terminal-text" data-i18n="about.techStack">TECH_STACK</span>
          </p>
          <div class="flex flex-wrap gap-2">
            {techStack.map((tech) => (
              <span class="px-3 py-1 text-sm border border-[#00ffff]/30 text-[#00ffff] bg-[#00ffff]/5 hover:bg-[#00ffff]/10 transition-colors">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Contact -->
        <div class="mt-8 pt-8 border-t border-[#00ff41]/20">
          <p class="terminal-dim text-sm mb-4">
            <span class="text-[#00ff41]/50">$</span> 
            <span class="terminal-text" data-i18n="about.contact">CONTACT</span>
          </p>
          <div class="flex gap-4">
            <a
              href="mailto:hi@magi.website"
              class="w-10 h-10 border border-[#00ff41]/30 flex items-center justify-center hover:border-[#00ff41] hover:bg-[#00ff41]/10 hover:shadow-lg hover:shadow-[#00ff41]/20 transition-all"
              aria-label="Email"
            >
              <svg class="w-5 h-5 text-[#00ff41]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </a>
            <a
              href="https://github.com/tokyo3rdhq"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 border border-[#00ff41]/30 flex items-center justify-center hover:border-[#00ff41] hover:bg-[#00ff41]/10 hover:shadow-lg hover:shadow-[#00ff41]/20 transition-all"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5 text-[#00ff41]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Command prompt -->
    <div class="mt-12 terminal-dim text-sm">
      <span class="text-[#00ff41]/50">$</span> 
      <span class="cursor-blink text-[#00ff41]">▮</span>
    </div>
  </div>
</section>
