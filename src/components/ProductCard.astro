---
interface Props {
  key: string;
  url: string;
  status?: 'active' | 'coming-soon';
}

const { key, url, status = 'active' } = Astro.props;

const labels: Record<string, string> = {
  api: 'API',
  chat: 'Chat',
  agent: 'Agent',
};
---

<a
  href={status === 'coming-soon' ? undefined : url}
  class:list={[
    'card-surface group flex h-full flex-col p-8 md:p-10 no-underline',
    status === 'coming-soon' && 'opacity-50 cursor-not-allowed',
  ]}
>
  <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent mb-8">
    {labels[key] ?? key}
  </p>

  <h3 class="text-2xl md:text-3xl font-semibold tracking-tighter text-ink-primary mb-4">
    <span data-i18n={`products.${key}.name`}>MAGI</span>
  </h3>

  <p
    class="text-base leading-relaxed text-ink-secondary mb-10 grow"
    data-i18n={`products.${key}.description`}
  ></p>

  {status === 'active' && (
    <span class="inline-flex items-center gap-1 text-sm font-medium text-accent transition-opacity group-hover:opacity-80">
      <span>Learn more</span>
      <span class="transition-transform group-hover:translate-x-0.5">›</span>
    </span>
  )}
</a>
