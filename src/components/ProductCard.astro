---
interface Props {
  name: string;
  description: string;
  url: string;
  icon: string;
  status?: 'active' | 'coming-soon';
}

const { name, description, url, icon, status = 'active' } = Astro.props;
---

<a
  href={status === 'coming-soon' ? undefined : url}
  class:list={[
    "group relative block p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm transition-all duration-300",
    status === 'active' && "hover:bg-white/10 hover:border-primary-500/50 hover:scale-[1.02] hover:shadow-xl hover:shadow-primary-500/10",
    status === 'coming-soon' && "opacity-60 cursor-not-allowed"
  ]}
>
  <!-- Icon -->
  <div class="w-12 h-12 mb-4 rounded-xl bg-gradient-to-br from-primary-500 to-purple-500 flex items-center justify-center text-2xl">
    {icon}
  </div>

  <!-- Content -->
  <h3 class="text-xl font-semibold mb-2 group-hover:text-primary-300 transition-colors">
    {name}
  </h3>
  <p class="text-slate-400 text-sm leading-relaxed">
    {description}
  </p>

  <!-- Status Badge -->
  {status === 'coming-soon' && (
    <span class="absolute top-4 right-4 px-2 py-1 text-xs bg-yellow-500/20 text-yellow-400 rounded-full">
      Coming Soon
    </span>
  )}

  <!-- Arrow (for active products) -->
  {status === 'active' && (
    <div class="absolute bottom-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity">
      <svg class="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </div>
  )}
</a>
