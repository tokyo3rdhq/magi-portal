---
/**
 * Theme toggle — system-aware light/dark cycle.
 *
 * Per DS Theme contract (docs/component-contracts.md AppTheme + ADR-0003):
 *   - Color mode is orthogonal to accent. `<html data-magi-theme="...">`
 *     is the contract; React's `<AppTheme>` is the runtime that writes it.
 *   - The DS provides both `:root, [data-magi-theme="dark"]` (canonical,
 *     default) and `[data-magi-theme="light"]` CSS rules.
 *
 * Per DS Experience Guidelines + docs/iconography.md: theme switch is a
 * conventional action → icon-only is allowed (Sun / Moon / Monitor).
 *
 * Click cycle adapts to system preference:
 *   If system prefers dark:  system → light → dark → system → …
 *   If system prefers light: system → dark → light → system → …
 *
 * The first option is "system" (the default state on first visit / no
 * localStorage value). One click moves to the OPPOSITE of system
 * preference, another click moves to the SAME as system preference
 * (explicitly locked), then back to system. This makes the most common
 * case — "I want it to just follow my OS" — the natural starting point;
 * users explicitly opt into a fixed theme only if they want to override.
 *
 * The trigger icon reflects the user's CHOICE:
 *   - Sun     when mode === 'dark'
 *   - Moon    when mode === 'light'
 *   - Monitor when mode === 'system'  (always Monitor when in system
 *                                       mode, regardless of OS state)
 * Exactly one icon is visible at a time; button width stays at 14px.
 *
 * Per DS Iconography contract (docs/iconography.md): generic UI icons
 * come from Lucide. Imported from lucide-static (SVG strings only —
 * no React/JS runtime; Astro can't import React).
 *
 * FOUC: an inline <script> in <head> (Layout.astro) sets
 * data-magi-theme synchronously before paint, applying the same
 * resolution so the very first paint is correct.
 */
import {
  Sun as SunSvg,
  Moon as MoonSvg,
  Monitor as MonitorSvg,
} from 'lucide-static';
---

<button
  id="theme-btn"
  type="button"
  class="text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center"
  aria-label="Switch theme"
  title="Switch theme"
>
  {/* Sun — shown when the user has chosen 'dark'. */}
  <span
    id="theme-icon-sun"
    class="theme-icon h-[14px] w-[14px] hidden"
    set:html={SunSvg}
  />
  {/* Moon — shown when the user has chosen 'light'. */}
  <span
    id="theme-icon-moon"
    class="theme-icon h-[14px] w-[14px] hidden"
    set:html={MoonSvg}
  />
  {/* Monitor — shown when the user has chosen 'system' (follow OS). */}
  <span
    id="theme-icon-monitor"
    class="theme-icon h-[14px] w-[14px] hidden"
    set:html={MonitorSvg}
  />
</button>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'theme';
    var DEFAULT_MODE = 'system'; // First option in the cycle.
    var mq = null;
    try {
      mq = window.matchMedia('(prefers-color-scheme: dark)');
    } catch (e) {
      mq = null;
    }

    /* Three valid stored values: 'system' | 'dark' | 'light'.
       Missing / unknown values are treated as 'system' (the default).
       This makes "no choice" semantically equivalent to "explicitly
       chose system" — both follow the OS preference. */
    function getStoredMode() {
      try {
        var v = localStorage.getItem(STORAGE_KEY);
        if (v === 'system' || v === 'dark' || v === 'light') return v;
      } catch (e) {
        /* localStorage may be blocked. */
      }
      return 'system';
    }

    /* Resolve the rendered theme. Stored choice wins; else OS. */
    function getEffectiveTheme(mode) {
      if (mode === 'dark' || mode === 'light') return mode;
      if (mq && typeof mq.matches === 'boolean') return mq.matches ? 'dark' : 'light';
      return 'dark'; // DS canonical
    }

    function applyIcon(mode) {
      var sun = document.getElementById('theme-icon-sun');
      var moon = document.getElementById('theme-icon-moon');
      var monitor = document.getElementById('theme-icon-monitor');
      if (sun && moon && monitor) {
        sun.classList.toggle('hidden', mode !== 'dark');
        moon.classList.toggle('hidden', mode !== 'light');
        monitor.classList.toggle('hidden', mode !== 'system');
      }
    }

    function applyAll(mode) {
      var theme = getEffectiveTheme(mode);
      document.documentElement.setAttribute('data-magi-theme', theme);
      applyIcon(mode);
    }

    function setMode(mode) {
      try {
        localStorage.setItem(STORAGE_KEY, mode);
      } catch (e) {
        /* ignore */
      }
      applyAll(mode);
    }

    var btn = document.getElementById('theme-btn');
    if (btn) {
      btn.addEventListener('click', function () {
        /* Cycle adapts to the system preference:
             If system prefers dark:  system → light → dark → system → …
             If system prefers light: system → dark → light → system → …
           Click 1 moves to the OPPOSITE of system, click 2 to the SAME
           as system (explicitly locked), click 3 back to system. */
        var current = getStoredMode();
        var sysDark = mq && typeof mq.matches === 'boolean' ? mq.matches : true;
        var sysTheme = sysDark ? 'dark' : 'light';
        var otherTheme = sysDark ? 'light' : 'dark';
        var next;
        if (current === 'system') next = otherTheme;
        else if (current === otherTheme) next = sysTheme;
        else next = 'system';
        setMode(next);
    }

    /* When the user has chosen 'light' or 'dark', OS flips are ignored.
       In any other state ('system' or no choice), follow OS. */
    if (mq && mq.addEventListener) {
      mq.addEventListener('change', function () {
        var mode = getStoredMode();
        if (mode === 'light' || mode === 'dark') return;
        applyAll(mode);
      });
    }

    /* Initial sync (header <head> FOUC script already set the attribute;
       this keeps the icon state in sync). */
    applyAll(getStoredMode());
  })();
</script>