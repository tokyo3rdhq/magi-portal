---
/**
 * Theme toggle — light/dark color mode switch.
 *
 * Per DS Theme contract (docs/component-contracts.md AppTheme + ADR-0003):
 *   - Color mode is orthogonal to accent. `<html data-magi-theme="...">`
 *     is the contract; React's `<AppTheme>` is the runtime that writes it.
 *   - The DS provides both `:root, [data-magi-theme="dark"]` (canonical,
 *     default) and `[data-magi-theme="light"]` CSS rules. Switching the
 *     attribute flips every color token — no per-component JS needed.
 *   - Per DS Experience Guidelines + docs/iconography.md: theme switch
 *     is a conventional action → icon-only is allowed with Sun/Moon.
 *
 * Astro boundary: @tokyo3rdhq/magi-design-system ships `<AppTheme>` as
 * a React component. This portal can't import React, so we wire the
 * same contract via vanilla JS + `<html data-magi-theme>`.
 *
 * System auto-switching (prefers-color-scheme):
 *   - First visit (no localStorage): read OS preference and follow it.
 *   - User explicit toggle: persist to localStorage; explicit choice
 *     always wins over subsequent OS theme changes.
 *   - Subsequent OS theme changes: only applied while the user hasn't
 *     explicitly toggled yet. Once they have, OS changes are ignored
 *     until they manually pick a different theme.
 *
 * FOUC: an inline <script> in <head> sets data-magi-theme synchronously
 * before paint, applying the same system+localStorage resolution so
 * the very first paint is correct.
 *
 * Per DS Iconography contract (docs/iconography.md): generic UI icons
 * come from Lucide. The portal imports Sun/Moon from lucide-static
 * (SVG strings only — no React/JS runtime; Astro can't import React).
 */
import { Sun as SunSvg, Moon as MoonSvg } from 'lucide-static';
---

<button
  id="theme-btn"
  type="button"
  class="text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center"
  aria-label="Switch theme"
  title="Switch theme"
>
  {/* Sun icon — shown when current theme is dark (clicking switches to light). */}
  <span
    id="theme-icon-light"
    class="theme-icon h-[14px] w-[14px]"
    set:html={SunSvg}
  />
  {/* Moon icon — shown when current theme is light (clicking switches to dark). */}
  <span
    id="theme-icon-dark"
    class="theme-icon h-[14px] w-[14px] hidden"
    set:html={MoonSvg}
  />
</button>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'theme';
    var DEFAULT_THEME = 'dark'; /* DS canonical; used when prefers-color-scheme is unavailable */
    var mq = null;
    try {
      mq = window.matchMedia('(prefers-color-scheme: dark)');
    } catch (e) {
      mq = null;
    }

    function getStored() {
      try {
        var v = localStorage.getItem(STORAGE_KEY);
        if (v === 'dark' || v === 'light') return v;
      } catch (e) {
        /* localStorage may be blocked. */
      }
      return null;
    }

    /* Effective theme = explicit choice, else OS preference, else default. */
    function getEffective() {
      var stored = getStored();
      if (stored) return stored;
      if (mq && typeof mq.matches === 'boolean') return mq.matches ? 'dark' : 'light';
      return DEFAULT_THEME;
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-magi-theme', theme);
      var lightIcon = document.getElementById('theme-icon-light');
      var darkIcon = document.getElementById('theme-icon-dark');
      if (lightIcon && darkIcon) {
        /* Sun = "click to switch to light" (shown in dark mode)
           Moon = "click to switch to dark" (shown in light mode) */
        lightIcon.classList.toggle('hidden', theme === 'light');
        darkIcon.classList.toggle('hidden', theme === 'dark');
      }
    }

    function setTheme(theme, persist) {
      applyTheme(theme);
      if (persist) {
        try {
          localStorage.setItem(STORAGE_KEY, theme);
        } catch (e) {
          /* ignore */
        }
      }
    }

    /* Initial sync (header <head> FOUC script already set the attribute;
       this keeps the icon state in sync and ensures the OS-driven case
       is handled even if the head script didn't pick up media-query
       support on older browsers). */
    applyTheme(getEffective());

    /* Follow the OS only if no explicit choice yet. Once the user has
       toggled, localStorage takes over and OS changes are ignored. */
    if (mq && mq.addEventListener) {
      var onSystemChange = function () {
        if (getStored() === null) {
          applyTheme(mq.matches ? 'dark' : 'light');
        }
      };
      mq.addEventListener('change', onSystemChange);
    }

    /* Toggle button: explicit override, always persisted. */
    var btn = document.getElementById('theme-btn');
    if (btn) {
      btn.addEventListener('click', function () {
        var next = getEffective() === 'dark' ? 'light' : 'dark';
        setTheme(next, true);
      });
    }
  })();
</script>