---
/**
 * Theme toggle — light/dark/system color mode switch.
 *
 * Per DS Theme contract (docs/component-contracts.md AppTheme + ADR-0003):
 *   - Color mode is orthogonal to accent. `<html data-magi-theme="...">`
 *     is the contract; React's `<AppTheme>` is the runtime that writes it.
 *   - The DS provides both `:root, [data-magi-theme="dark"]` (canonical,
 *     default) and `[data-magi-theme="light"]` CSS rules. Switching the
 *     attribute flips every color token — no per-component JS needed.
 *   - Per DS Experience Guidelines + docs/iconography.md: theme switch
 *     is a conventional action → icon-only is allowed (Sun / Moon /
 *     Monitor).
 *
 * Three-state cycle (click): dark → light → system → dark.
 * The icon shown in the button reflects the EFFECTIVE theme:
 *   - Sun    when the page is rendering in dark
 *   - Moon   when the page is rendering in light
 *   - Monitor when the user has explicitly chosen "system"
 *             (i.e., the icon is constant regardless of OS; the click
 *             goes to the next state in the cycle).
 *
 * Per DS Iconography contract (docs/iconography.md): generic UI icons
 * come from Lucide. The portal imports Sun/Moon/Monitor from
 * lucide-static (SVG strings only — no React/JS runtime; Astro can't
 * import React).
 *
 * Astro boundary: @tokyo3rdhq/magi-design-system ships `<AppTheme>`
 * as a React component. This portal can't import React, so we wire
 * the same contract via vanilla JS + `<html data-magi-theme>`.
 *
 * Resolution rule:
 *   - localStorage['theme'] === 'dark' | 'light' → user wins
 *   - localStorage['theme'] === 'system' → follow OS preference;
 *     localStorage stays as 'system' (NOT removed, so the cycle is
 *     preserved on next render).
 *   - no localStorage → follow OS preference.
 *
 * FOUC: an inline <script> in <head> sets data-magi-theme synchronously
 * before paint, applying the same resolution so the very first paint
 * is correct.
 */
import {
  Sun as SunSvg,
  Moon as MoonSvg,
  Monitor as MonitorSvg,
} from 'lucide-static';
---

<button
  id="theme-btn"
  type="button"
  class="text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center"
  aria-label="Switch theme"
  title="Switch theme"
>
  {/* Sun — shown when the effective theme is dark (click → light). */}
  <span
    id="theme-icon-sun"
    class="theme-icon h-[14px] w-[14px]"
    set:html={SunSvg}
  />
  {/* Moon — shown when the effective theme is light (click → system). */}
  <span
    id="theme-icon-moon"
    class="theme-icon h-[14px] w-[14px] hidden"
    set:html={MoonSvg}
  />
  {/* Monitor — shown when the user has explicitly chosen "system"
      (click → dark). The icon is constant regardless of the OS
      preference — it signals "follow the system". */}
  <span
    id="theme-icon-monitor"
    class="theme-icon h-[14px] w-[14px] hidden"
    set:html={MonitorSvg}
  />
</button>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'theme';
    var DEFAULT_THEME = 'dark'; /* DS canonical; used when prefers-color-scheme is unavailable */
    var mq = null;
    try {
      mq = window.matchMedia('(prefers-color-scheme: dark)');
    } catch (e) {
      mq = null;
    }

    /* Read the user's stored preference. Three valid values:
         'dark' | 'light' | 'system'
       Anything else (including missing) is treated as 'system'. */
    function getStored() {
      try {
        var v = localStorage.getItem(STORAGE_KEY);
        if (v === 'dark' || v === 'light' || v === 'system') return v;
      } catch (e) {
        /* localStorage may be blocked. */
      }
      return 'system';
    }

    /* The theme actually rendered on screen. Falls back to OS
       preference when the user's choice is 'system' (or unset). */
    function getEffective() {
      var stored = getStored();
      if (stored === 'dark' || stored === 'light') return stored;
      if (mq && typeof mq.matches === 'boolean') return mq.matches ? 'dark' : 'light';
      return DEFAULT_THEME;
    }

    function applyTheme(theme, mode) {
      /* mode:
           'dark' | 'light'   → user has chosen a fixed theme
           'system'           → user has chosen to follow the OS */
      document.documentElement.setAttribute('data-magi-theme', theme);
      var sun = document.getElementById('theme-icon-sun');
      var moon = document.getElementById('theme-icon-moon');
      var monitor = document.getElementById('theme-icon-monitor');
      if (sun && moon && monitor) {
        /* Icon visibility:
           - In 'dark' or 'light' mode: show only the matching icon
             (Sun for dark, Moon for light). Monitor is hidden because
             the user has committed to a fixed theme.
           - In 'system' mode: show ONLY the Monitor icon. Sun/Moon are
             hidden because the user's *choice* is "follow the OS",
             not a fixed theme — the icon should reflect the choice,
             not the OS's current state. When the OS flips, the page
             follows automatically; the icon stays as Monitor. */
        var isSystem = mode === 'system';
        var showSun = !isSystem && theme === 'dark';
        var showMoon = !isSystem && theme === 'light';
        var showMonitor = isSystem;
        sun.classList.toggle('hidden', !showSun);
        moon.classList.toggle('hidden', !showMoon);
        monitor.classList.toggle('hidden', !showMonitor);
      }
    }

    function setTheme(mode) {
      try {
        localStorage.setItem(STORAGE_KEY, mode);
      } catch (e) {
        /* ignore */
      }
      applyTheme(getEffective(), mode);
    }

    function syncIconsForCurrentMode() {
      applyTheme(getEffective(), getStored());
    }

    /* Click cycle: dark → light → system → dark → … */
    var btn = document.getElementById('theme-btn');
    if (btn) {
      btn.addEventListener('click', function () {
        var current = getStored();
        var next;
        if (current === 'dark') next = 'light';
        else if (current === 'light') next = 'system';
        else next = 'dark';
        setTheme(next);
      });
    }

    /* Follow the OS only if the user hasn't picked a fixed theme.
       Once the user has chosen 'dark' or 'light', OS changes are
       ignored. In 'system' mode, every OS flip re-renders. */
    if (mq && mq.addEventListener) {
      var onSystemChange = function () {
        var stored = getStored();
        if (stored === 'dark' || stored === 'light') return;
        applyTheme(mq.matches ? 'dark' : 'light', stored);
      };
      mq.addEventListener('change', onSystemChange);
    }

    /* Initial sync (header <head> FOUC script already set the attribute;
       this keeps the icon state in sync). */
    syncIconsForCurrentMode();
  })();
</script>