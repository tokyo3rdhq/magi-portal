---
/**
 * Theme picker — dropdown menu for light/dark/system.
 *
 * Per DS Theme contract (docs/component-contracts.md AppTheme + ADR-0003):
 *   - Color mode is orthogonal to accent. `<html data-magi-theme="...">`
 *     is the contract; React's `<AppTheme>` is the runtime that writes it.
 *   - The DS provides both `:root, [data-magi-theme="dark"]` (canonical,
 *     default) and `[data-magi-theme="light"]` CSS rules.
 *
 * Per DS Experience Guidelines + docs/iconography.md: theme picker is a
 * conventional action → icon-only trigger allowed.
 *
 * No cycle. The button opens a small dropdown (matching the lang
 * button's pattern) with three explicit options: Light / Dark / System.
 * The user picks one; that choice is stored in localStorage.
 *
 * Default state = "system". When no choice is stored, the page follows
 * the OS preference via prefers-color-scheme. The "system" option is
 * the explicit form of "no choice / follow OS".
 *
 * Trigger button icon reflects the user's CHOICE (not the OS state):
 *   - Sun     when mode === 'dark'
 *   - Moon    when mode === 'light'
 *   - Monitor when mode === 'system'  (always Monitor, even when the
 *                                        OS is dark — signals "follow system")
 * Only one icon is visible at a time; button width stays at 14px.
 *
 * Per DS Iconography contract (docs/iconography.md): generic UI icons
 * come from Lucide. Imported from lucide-static (SVG strings only —
 * no React/JS runtime; Astro can't import React).
 *
 * FOUC: an inline <script> in <head> (Layout.astro) sets
 * data-magi-theme synchronously before paint, applying the same
 * resolution so the very first paint is correct.
 */
import {
  Sun as SunSvg,
  Moon as MoonSvg,
  Monitor as MonitorSvg,
} from 'lucide-static';
---

<div id="theme-switcher" class="relative">
  <button
    id="theme-btn"
    type="button"
    class="text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center"
    aria-label="Switch theme"
    aria-haspopup="listbox"
    aria-expanded="false"
    title="Theme"
  >
    {/* One icon visible at a time based on the user's SELECTION. */}
    <span
      id="theme-icon-sun"
      class="theme-icon h-[14px] w-[14px] hidden"
      set:html={SunSvg}
    />
    <span
      id="theme-icon-moon"
      class="theme-icon h-[14px] w-[14px] hidden"
      set:html={MoonSvg}
    />
    <span
      id="theme-icon-monitor"
      class="theme-icon h-[14px] w-[14px] hidden"
      set:html={MonitorSvg}
    />
  </button>
  <div
    id="theme-dropdown"
    role="listbox"
    aria-label="Theme"
    class="hidden absolute right-0 top-full mt-2 min-w-[140px] rounded-xl border border-line bg-bg-raised/95 backdrop-blur-xl shadow-2xl overflow-hidden z-50"
  >
    <button
      type="button"
      role="option"
      data-theme-mode="light"
      class="block w-full px-4 py-2 text-left text-xs text-ink-secondary hover:bg-white/5 hover:text-ink-primary transition-colors"
    >
      Light
    </button>
    <button
      type="button"
      role="option"
      data-theme-mode="dark"
      class="block w-full px-4 py-2 text-left text-xs text-ink-secondary hover:bg-white/5 hover:text-ink-primary transition-colors"
    >
      Dark
    </button>
    <button
      type="button"
      role="option"
      data-theme-mode="system"
      class="block w-full px-4 py-2 text-left text-xs text-ink-secondary hover:bg-white/5 hover:text-ink-primary transition-colors"
    >
      System
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'theme';
    var DEFAULT_MODE = 'system'; // 'system' = follow OS preference
    var mq = null;
    try {
      mq = window.matchMedia('(prefers-color-scheme: dark)');
    } catch (e) {
      mq = null;
    }

    /* Read the user's stored mode. Three valid values:
         'light' | 'dark' | 'system'
       Anything else (including missing) is treated as 'system' — the
       page then follows prefers-color-scheme. */
    function getStoredMode() {
      try {
        var v = localStorage.getItem(STORAGE_KEY);
        if (v === 'light' || v === 'dark' || v === 'system') return v;
      } catch (e) {
        /* localStorage may be blocked. */
      }
      return 'system';
    }

    /* The theme actually rendered on screen. */
    function getEffectiveTheme(mode) {
      if (mode === 'light' || mode === 'dark') return mode;
      if (mq && typeof mq.matches === 'boolean') return mq.matches ? 'dark' : 'light';
      return 'dark'; // DS canonical
    }

    function applyIcon(mode, theme) {
      /* Icon reflects the user's CHOICE, not the OS state. Only one
         icon visible at a time. */
      var sun = document.getElementById('theme-icon-sun');
      var moon = document.getElementById('theme-icon-moon');
      var monitor = document.getElementById('theme-icon-monitor');
      if (sun && moon && monitor) {
        var showSun = mode === 'dark';
        var showMoon = mode === 'light';
        var showMonitor = mode === 'system';
        sun.classList.toggle('hidden', !showSun);
        moon.classList.toggle('hidden', !showMoon);
        monitor.classList.toggle('hidden', !showMonitor);
      }
    }

    function applyAll(mode) {
      var theme = getEffectiveTheme(mode);
      document.documentElement.setAttribute('data-magi-theme', theme);
      applyIcon(mode, theme);
      syncDropdown(mode);
    }

    function syncDropdown(mode) {
      var dropdown = document.getElementById('theme-dropdown');
      if (!dropdown) return;
      dropdown.querySelectorAll('button[data-theme-mode]').forEach(function (b) {
        var isActive = b.dataset.themeMode === mode;
        b.classList.toggle('text-ink-primary', isActive);
        b.classList.toggle('bg-white/5', isActive);
      });
    }

    function setMode(mode) {
      if (mode !== 'light' && mode !== 'dark' && mode !== 'system') return;
      try {
        if (mode === 'system') {
          /* 'system' is the same as 'no choice' — remove the stored
             value so a future OS-flip listener takes over. */
          localStorage.removeItem(STORAGE_KEY);
        } else {
          localStorage.setItem(STORAGE_KEY, mode);
        }
      } catch (e) {
        /* ignore */
      }
      applyAll(getStoredMode());
    }

    var btn = document.getElementById('theme-btn');
    var dropdown = document.getElementById('theme-dropdown');
    if (btn && dropdown) {
      var setOpen = function (open) {
        dropdown.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
      };
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = !dropdown.classList.contains('hidden');
        setOpen(!isOpen);
      });
      document.addEventListener('click', function () { setOpen(false); });
      // Escape closes the dropdown (per WAI-ARIA listbox keyboard pattern).
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          setOpen(false);
          btn.focus();
        }
      });
      dropdown.querySelectorAll('button[data-theme-mode]').forEach(function (opt) {
        opt.addEventListener('click', function (e) {
          e.stopPropagation();
          setMode(opt.dataset.themeMode);
          setOpen(false);
          btn.focus();
        });
      });
    }

    /* When the user has chosen 'light' or 'dark', OS flips are
       ignored. In any other state ('system' or no choice), follow OS. */
    if (mq && mq.addEventListener) {
      mq.addEventListener('change', function () {
        var mode = getStoredMode();
        if (mode === 'light' || mode === 'dark') return;
        applyAll(mode);
      });
    }

    /* Initial sync (header <head> FOUC script already set the attribute;
       this keeps the icon + dropdown state in sync). */
    applyAll(getStoredMode());
  })();
</script>