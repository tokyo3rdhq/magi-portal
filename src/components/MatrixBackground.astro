---
// Subtle radial glow overlay for depth. Pure CSS — no JS, no canvas.
//
// Layered gradients reference design-system tokens via color-mix() so the
// accent stop follows whatever accent the consuming app declares (magi-
// portal uses green; future products may override via <AppTheme> or
// <div data-magi-accent="..."> subtree attributes).
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
  <div
    class="absolute -top-1/3 left-1/2 -translate-x-1/2 w-[120vw] h-[120vh] max-w-none"
    style="background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.05) 0%,
      color-mix(in srgb, var(--magi-accent) 3%, transparent) 35%,
      transparent 70%
    );"
  >
  </div>
</div>
