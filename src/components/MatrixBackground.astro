---
// Subtle radial glow overlay for depth. Pure CSS — no JS, no canvas.
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
  <div class="absolute -top-1/3 left-1/2 -translate-x-1/2 w-[120vw] h-[120vh] max-w-none
              bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.05)_0%,rgba(0,200,83,0.03)_35%,transparent_70%)]">
  </div>
</div>
