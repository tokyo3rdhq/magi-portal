---
import ProductCard from './ProductCard.astro';

const products = [
  {
    key: 'api',
    url: 'https://api.magi.website',
  },
  {
    key: 'chat',
    url: 'https://chat.magi.website',
  },
  {
    key: 'agent',
    url: 'https://agent.magi.website',
  },
];
---

<section id="products" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="text-primary-400 font-medium mb-4 block" data-i18n="products.label">产品矩阵</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        <span data-i18n="products.title">我的</span> <span class="text-primary-400" data-i18n="products.titleHighlight">AI 产品</span>
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto" data-i18n="products.description">
        基于 Cloudflare Edge 构建的高性能 AI 服务，覆盖 API、对话、Agent 三大场景
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <ProductCard
        key="api"
        url={products[0].url}
      />
      <ProductCard
        key="chat"
        url={products[1].url}
      />
      <ProductCard
        key="agent"
        url={products[2].url}
      />
    </div>
  </div>
</section>
