---
import ProductCard from './ProductCard.astro';

const products = [
  { key: 'api', url: 'https://api.magi.website' },
  { key: 'chat', url: 'https://chat.magi.website' },
  { key: 'agent', url: 'https://agent.magi.website' },
];
---

<section id="products" class="relative px-6 py-32 md:py-40">
  <div class="mx-auto max-w-page">
    <div class="mx-auto max-w-wide text-center mb-16 md:mb-20">
      <p class="magi-eyebrow mb-5" data-i18n="products.eyebrow">Products</p>
      <h2
        class="magi-h2 text-4xl md:text-5xl lg:text-6xl text-balance whitespace-pre-line"
        data-i18n="products.headline"
      >
        Three systems.
One platform.
      </h2>
      <p
        class="mt-5 text-lg md:text-xl text-ink-secondary max-w-prose mx-auto text-balance"
        data-i18n="products.subhead"
      >
        Production-grade AI services, deployed at the edge.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {products.map((product) => (
        <ProductCard key={product.key} url={product.url} />
      ))}
    </div>
  </div>
</section>
