---
import ProductCard from './ProductCard.astro';

const products = [
  { key: 'api', url: 'https://api.magi.website' },
  { key: 'chat', url: 'https://chat.magi.website' },
  { key: 'agent', url: 'https://agent.magi.website' },
];
---

<section id="products" class="relative py-24 px-4">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="mb-12">
      <p class="terminal-dim text-sm mb-2">
        <span class="text-[#00ff41]/50">$</span> ls -la /products/
      </p>
      <h2 class="text-2xl md:text-4xl font-bold mb-4">
        <span class="terminal-dim">[</span>
        <span class="terminal-text" data-i18n="products.label">PRODUCT_PORTFOLIO</span>
        <span class="terminal-dim">]</span>
      </h2>
      <p class="terminal-dim max-w-2xl" data-i18n="products.description">
        High-performance AI services deployed on Cloudflare Edge network
      </p>
    </div>

    <!-- Products grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product) => (
        <ProductCard key={product.key} url={product.url} />
      ))}
    </div>
    
    <!-- Command prompt -->
    <div class="mt-12 terminal-dim text-sm">
      <span class="text-[#00ff41]/50">$</span> 
      <span class="cursor-blink text-[#00ff41]">▮</span>
    </div>
  </div>
</section>
