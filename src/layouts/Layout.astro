---
import '../styles/global.css';
import { locales, translations } from '../i18n';
import MatrixBackground from '../components/MatrixBackground.astro';
// Read the canonical MAGI lockup SVG (single source of truth in
// node_modules/@tokyo3rdhq/magi-design-system/dist/assets/logo/, copied
// into public/ by scripts/sync-brand.mjs on every install — see audit
// F-001/F-006). We import as raw text so `set:html` inlines it and
// `fill="currentColor"` resolves from the host element's `color`,
// honoring the DS Logo Contrast Rule (--magi-logo-color).
import magiLockupSvg from '../../public/magi-lockup.svg?raw';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://magi.website';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'MAGI';
const gaId = import.meta.env.PUBLIC_GA_ID || '';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Home',
  description = `${siteName} — Personal AI Lab. Independent developer building AI products and services on Cloudflare Edge.`,
} = Astro.props;

const fullTitle = title === 'Home' ? `${siteName} — Personal AI Lab` : `${title} | ${siteName}`;

const navItems = [
  { key: 'products', href: '#products' },
  { key: 'features', href: '#features' },
  { key: 'about', href: '#about' },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-magi-app>
  <head>
    {/* Set <html lang> synchronously before paint to prevent FOUC for
        returning zh users (audit F-008). Inline script runs on parse,
        before any CSS or content paints. Keeps in sync with the full
        i18n bootstrap at the end of <body>. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('locale');
          if (saved === 'zh' || saved === 'en') {
            document.documentElement.lang = saved === 'zh' ? 'zh-CN' : 'en';
          }
        } catch (e) {
          /* localStorage may be blocked; default lang="en" from SSR is fine. */
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />

    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-default.png`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-default.png`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <slot name="jsonld" />
  </head>
  <body class="min-h-screen relative overflow-x-hidden">
    <MatrixBackground />

    <!-- Top navigation -->
    <header class="sticky top-0 z-40 backdrop-blur-xl bg-bg-raised/95 border-b border-line">
      <nav class="mx-auto flex h-11 max-w-page items-center justify-between px-6">
        {/* Header logo link.
   *
   * Brand contract (per DS docs/component-contracts.md MagiLockup):
   *   - Inline <svg> with fill="currentColor" (currentColor cascades
   *     from the host element's `color`).
   *   - Stable across product accents (no --magi-accent).
   *   - Logo Color Rule: brand components inherit --magi-logo-color
   *     (which equals --magi-text-primary in both themes today, but
   *     is independently overridable per DS). The .magi-lockup class
   *     triggers the DS rule in packages/design-system/src/brand/
   *     brand.css that sets `color: var(--magi-logo-color)` on the
   *     wrapper.
   *   - aria-hidden="true" on the SVG; the wrapping <a aria-label>
   *     is the accessible name.
   *
   * Size: 80×18 matches the original Apple-style header logo and
   * falls between the DS sm (20px tall) and lg (48px tall) sizes.
   * The portal uses its own `.logo-link svg` rule for dimensions
   * because @astrojs/react is not adopted (Astro boundary).
   *
   * Single source of truth: the SVG content is imported as raw text
   * from public/magi-lockup.svg, which scripts/sync-brand.mjs copies
   * from node_modules/@tokyo3rdhq/magi-design-system/dist/assets/logo/
   * on every install. */}
<a
          href="/"
          aria-label="MAGI — home"
          class="magi-lockup logo-link opacity-90 hover:opacity-100 transition-opacity"
        ><span aria-hidden="true" set:html={magiLockupSvg} /></a>
        <ul class="hidden md:flex items-center gap-8">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link" data-i18n={`nav.${item.key}`}>
                {item.key}
              </a>
            </li>
          ))}
        </ul>
        <!--
          Per docs/guidelines.md §11 (Header utility area):
          - Avoid the icon dump. Group + prioritize.
          - Per §6 iconography matrix: GitHub / Discord / Docs / Status are
            destinations → Text (or Icon + Text when space allows).
          - Per §8/§9: external destinations get the ↗ indicator + new-tab SR announcement.
          Order chosen for this portal: GitHub → Discord → Docs → Status → language.
        -->
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/tokyo3rdhq"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center gap-1"
          >
            <svg
              class="h-[14px] w-[14px]"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
            </svg>
            GitHub
            <span aria-hidden="true" class="opacity-60">↗</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
          <a
            href="https://discord.gg/gTGnvTdyec"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center gap-1"
          >
            Discord
            <span aria-hidden="true" class="opacity-60">↗</span>
            <span class="sr-only">(opens in new tab)</span>
          </a>
          <a
            href="/docs"
            class="text-xs text-ink-secondary hover:text-ink-primary transition-colors"
            data-i18n="footer.docs"
          >
            Documentation
          </a>
          <a
            href="/status"
            class="text-xs text-ink-secondary hover:text-ink-primary transition-colors"
            data-i18n="footer.status"
          >
            Status
          </a>
          <div id="lang-switcher" class="relative">
            <button
              id="lang-btn"
              class="text-xs font-medium text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center gap-0.5"
              aria-label="Switch language"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span id="current-lang">{locales.en}</span>
              <span aria-hidden="true">▾</span>
            </button>
            <div
              id="lang-dropdown"
              role="listbox"
              aria-label="Language"
              class="hidden absolute right-0 top-full mt-2 min-w-[140px] rounded-xl border border-line bg-bg-raised/95 backdrop-blur-xl shadow-2xl overflow-hidden z-50"
            >
              {Object.entries(locales).map(([code, name]) => (
                <button
                  role="option"
                  aria-selected={code === 'en'}
                  data-locale={code}
                  class="block w-full px-4 py-2 text-left text-xs text-ink-secondary hover:bg-white/5 hover:text-ink-primary transition-colors"
                >
                  {name}
                </button>
              ))}
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <!--
      Per docs/guidelines.md §12 (Footer) and §13 (Product vs System boundary):
      - Brand-required zones: brand + legal (Privacy / Terms) + copyright + language
      - Product-owned zones: community destinations, footer column structure
      Single-column on mobile, three-column on desktop (Community / Legal / Language)
      plus a baseline row with copyright.
    -->
    <footer class="relative z-10 border-t border-line mt-32">
      <div class="mx-auto max-w-page px-6 py-12">
        <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
          <div>
            <div class="magi-eyebrow mb-4" data-i18n="footer.brand">MAGI</div>
            <p class="magi-caption text-ink-tertiary" data-i18n="footer.tagline">
              Personal AI Lab.
            </p>
          </div>

          <div>
            <div class="magi-eyebrow mb-4" data-i18n="footer.community">Community</div>
            <ul class="space-y-2 text-sm">
              <li>
                <a
                  href="https://github.com/tokyo3rdhq"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center gap-1"
                >
                  GitHub <span aria-hidden="true" class="opacity-60">↗</span>
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              </li>
              <li>
                <a
                  href="https://discord.gg/gTGnvTdyec"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-secondary hover:text-ink-primary transition-colors inline-flex items-center gap-1"
                >
                  Discord <span aria-hidden="true" class="opacity-60">↗</span>
                  <span class="sr-only">(opens in new tab)</span>
                </a>
              </li>
            </ul>
          </div>

          <div>
            <div class="magi-eyebrow mb-4" data-i18n="footer.resources">Resources</div>
            <ul class="space-y-2 text-sm">
              <li>
                <a
                  href="/docs"
                  class="text-ink-secondary hover:text-ink-primary transition-colors"
                  data-i18n="footer.docs"
                >
                  Documentation
                </a>
              </li>
              <li>
                <a
                  href="/status"
                  class="text-ink-secondary hover:text-ink-primary transition-colors"
                  data-i18n="footer.status"
                >
                  Status
                </a>
              </li>
            </ul>
          </div>

          <div>
            <div class="magi-eyebrow mb-4" data-i18n="footer.legal">Legal</div>
            <ul class="space-y-2 text-sm">
              <li>
                <a
                  href="/legal/privacy"
                  class="text-ink-secondary hover:text-ink-primary transition-colors"
                  data-i18n="footer.privacy"
                >
                  Privacy
                </a>
              </li>
              <li>
                <a
                  href="/legal/terms"
                  class="text-ink-secondary hover:text-ink-primary transition-colors"
                  data-i18n="footer.terms"
                >
                  Terms
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="mt-10 pt-6 border-t border-line flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-ink-tertiary"
        >
          <p>
            <span data-i18n="footer.copyright">Copyright</span>
            © {currentYear} <span data-i18n="footer.brandName">MAGI</span>.
            <span data-i18n="footer.rights">All rights reserved.</span>
          </p>
          <p class="flex items-center gap-1">
            <span aria-hidden="true" class="opacity-60">@</span>
            <a
              href="mailto:hi@magi.website"
              class="text-ink-secondary hover:text-ink-primary transition-colors"
              data-i18n="footer.contact"
            >
              hi@magi.website
            </a>
          </p>
        </div>
      </div>
    </footer>

    <!-- Locale switcher + i18n -->
    <script is:inline define:vars={{ translations, locales }}>
      // Translation dictionaries (translations) and locale labels
      // (locales) are injected from src/i18n/* via define:vars.
      // Everything below is self-contained so it can run inside the
      // page's inline <script> block.

      function getLocale() {
        const saved = localStorage.getItem('locale');
        if (saved === 'zh' || saved === 'en') return saved;
        return 'en';
      }

      function setLocale(locale) {
        if (locale !== 'zh' && locale !== 'en') return;
        localStorage.setItem('locale', locale);
        document.documentElement.lang = locale === 'zh' ? 'zh-CN' : 'en';
        applyTranslations();
        syncActiveLocaleButton();
      }

      function getNestedValue(obj, keys) {
        let value = obj;
        for (const k of keys) {
          const index = parseInt(k, 10);
          if (!isNaN(index) && Array.isArray(value)) value = value[index];
          else if (value && typeof value === 'object') value = value[k];
          else return undefined;
        }
        return value;
      }

      function applyTranslations() {
        const locale = getLocale();
        const trans = translations[locale] || translations.en;
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const value = getNestedValue(trans, key.split('.'));
          if (typeof value === 'string') el.textContent = value;
        });
        const currentEl = document.getElementById('current-lang');
        if (currentEl) currentEl.textContent = locales[locale];
      }

      function syncActiveLocaleButton() {
        const dropdown = document.getElementById('lang-dropdown');
        if (!dropdown) return;
        const active = getLocale();
        dropdown.querySelectorAll('button[data-locale]').forEach((b) => {
          const isActive = b.dataset.locale === active;
          b.classList.toggle('text-ink-primary', isActive);
          b.classList.toggle('bg-white/5', isActive);
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        const locale = getLocale();
        document.documentElement.lang = locale === 'zh' ? 'zh-CN' : 'en';
        applyTranslations();
        syncActiveLocaleButton();

        const langBtn = document.getElementById('lang-btn');
        const langDropdown = document.getElementById('lang-dropdown');
        if (langBtn && langDropdown) {
          const langOptions = Array.from(
            langDropdown.querySelectorAll('button[data-locale]')
          );
          let langFocusIndex = langOptions.findIndex(
            (b) => b.dataset.locale === getLocale()
          );
          if (langFocusIndex < 0) langFocusIndex = 0;

          const setOpen = (open) => {
            langDropdown.classList.toggle('hidden', !open);
            langBtn.setAttribute('aria-expanded', String(open));
            if (open) {
              // Move focus into the listbox per WAI-ARIA listbox pattern.
              langFocusIndex = Math.max(
                0,
                langOptions.findIndex(
                  (b) => b.dataset.locale === getLocale()
                )
              );
              langOptions[langFocusIndex]?.focus();
            }
          };

          langBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = !langDropdown.classList.contains('hidden');
            setOpen(!isOpen);
          });
          document.addEventListener('click', () => setOpen(false));

          // WAI-ARIA listbox keyboard pattern (audit F-019):
          // ArrowDown / ArrowUp move focus; Home / End jump to first / last;
          // Enter / Space activate; Escape closes and returns focus to the button.
          langBtn.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              setOpen(true);
            } else if (e.key === 'Escape') {
              setOpen(false);
            }
          });
          langDropdown.addEventListener('keydown', (e) => {
            const last = langOptions.length - 1;
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              langFocusIndex = Math.min(last, langFocusIndex + 1);
              langOptions[langFocusIndex].focus();
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              langFocusIndex = Math.max(0, langFocusIndex - 1);
              langOptions[langFocusIndex].focus();
            } else if (e.key === 'Home') {
              e.preventDefault();
              langFocusIndex = 0;
              langOptions[0].focus();
            } else if (e.key === 'End') {
              e.preventDefault();
              langFocusIndex = last;
              langOptions[last].focus();
            } else if (e.key === 'Escape') {
              setOpen(false);
              langBtn.focus();
            } else if (e.key === 'Tab') {
              // Tab closes the dropdown and lets focus continue to the
              // next focusable element (default browser behavior).
              setOpen(false);
            }
          });
          langOptions.forEach((btn, i) => {
            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              const code = btn.dataset.locale;
              if (code) {
                setLocale(code);
                langFocusIndex = i;
                setOpen(false);
                langBtn.focus();
              }
            });
          });
          syncActiveLocaleButton();
        }

        // Apple-style: show the thin scrollbar thumb only while actively scrolling.
        // Sets data-scrolling on <body> so @magi/design-system's scrollbar rules
        // (which target body[data-magi-app][data-scrolling]) take effect.
        let scrollTimer = null;
        const SCROLL_VISIBLE_MS = 800;
        window.addEventListener('scroll', () => {
          document.body.dataset.scrolling = '';
          if (scrollTimer) clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => {
            delete document.body.dataset.scrolling;
          }, SCROLL_VISIBLE_MS);
        }, { passive: true });
      });
    </script>
  </body>
</html>
